# --- Secrets and local config (never commit) ---
.env
*.tfvars
!*.tfvars.example

# --- Terraform working files and state (state can contain secret values) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
crash.log

# --- Scan output (contains details about your AWS account) ---
results/*
!results/.gitkeep
simulation/log.json

# --- Python ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
