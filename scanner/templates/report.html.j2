<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AWS Security Assessment {{ scan.scan_id }}</title>
<style>
  :root {
    --surface: #ffffff; --surface-2: #f6f6f4; --border: #e2e2dd;
    --text: #191919; --text-2: #666666;
    --critical: #dc3c3d; --serious: #f18a59; --warning: #fbb315; --low: #9c9c9c; --good: #0aac23;
    --accent: #257de0;
  }
  @media (prefers-color-scheme: dark) {
    :root { --surface: #191919; --surface-2: #232323; --border: #383838;
            --text: #efefef; --text-2: #9c9c9c; --accent: #338ced; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--surface); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1040px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 26px; margin: 0 0 4px; }
  h2 { font-size: 19px; margin: 40px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
  .meta { color: var(--text-2); font-size: 13px; }
  .banner { margin: 16px 0; padding: 10px 14px; border-radius: 8px; font-size: 14px;
            background: var(--surface-2); border-left: 4px solid var(--warning); }
  .banner.live { border-left-color: var(--accent); }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-top: 16px; }
  .tile { background: var(--surface-2); border-radius: 10px; padding: 14px 16px; }
  .tile .label { color: var(--text-2); font-size: 13px; }
  .tile .value { font-size: 30px; font-weight: 650; font-variant-numeric: tabular-nums; }
  .tile .value small { font-size: 15px; color: var(--text-2); font-weight: 400; }
  .sev { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; font-size: 13px; }
  .sev::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--c); }
  .sev.critical { --c: var(--critical); } .sev.high { --c: var(--serious); }
  .sev.medium { --c: var(--warning); } .sev.low { --c: var(--low); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--text-2); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
  td.num { font-variant-numeric: tabular-nums; text-align: right; }
  .table-wrap { overflow-x: auto; }
  code { font: 13px ui-monospace, SFMono-Regular, Consolas, monospace; }
  .bars { display: grid; gap: 6px; }
  .bar-row { display: grid; grid-template-columns: 150px 1fr 48px; gap: 10px; align-items: center; font-size: 13px; }
  .bar-track { height: 10px; background: var(--surface-2); border-radius: 0 4px 4px 0; }
  .bar { height: 10px; background: var(--accent); border-radius: 0 4px 4px 0; }
  .new { color: var(--critical); font-weight: 600; } .resolved { color: var(--good); font-weight: 600; }
  .rec { padding: 12px 0; border-bottom: 1px solid var(--border); }
  .rec h3 { font-size: 15px; margin: 0 0 4px; }
  .muted { color: var(--text-2); }
  @media print { .banner, .tile { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
</style>
</head>
<body>
<main>
  <h1>AWS Security Posture Assessment</h1>
  <div class="meta">Scan {{ scan.scan_id }} &middot; account {{ scan.account_id }} &middot; {{ scan.region }}
    &middot; {{ scan.started_at }} UTC</div>

  {% if scan.mode == "demo" %}
  <div class="banner"><strong>DEMO MODE.</strong> These results come from a local AWS emulator (moto),
    not a real AWS account. Activity events were generated by the attack simulator. See docs/emulator.md.</div>
  {% else %}
  <div class="banner live"><strong>LIVE MODE.</strong> Results from the real AWS account {{ scan.account_id }}.</div>
  {% endif %}

  <h2>Executive summary</h2>
  {% if summary.low_coverage %}
  <div class="banner"><strong>Low coverage ({{ summary.coverage_pct }}%).</strong> Most checks could not be
    evaluated (missing read permissions), so the score below is not meaningful.</div>
  {% endif %}
  <p>
    The account scores <strong>{{ summary.score }}/100</strong> on {{ summary.results }} check results
    ({{ summary.passed }} passed, {{ summary.failed }} failed{% if summary.errors %}, {{ summary.errors }} could not be evaluated{% endif %}).
    {% if summary.failed_by_severity.critical %}<strong>{{ summary.failed_by_severity.critical }} critical</strong> finding(s) need immediate attention.{% endif %}
    {% if drift %}Since the previous scan the score changed by <strong>{{ "%+.1f"|format(drift.score_change) }}</strong>:
      {{ drift.new|length }} new and {{ drift.resolved|length }} resolved finding(s).{% endif %}
    {% if alert_count %}The threat detection engine has raised {{ alert_count }} alert(s){% if mttd %}, detecting
      {{ mttd_detected }} of {{ mttd|length }} simulated attacks{% if mttd_mean is not none %} with a mean time to detect of {{ mttd_mean }} s{% endif %}{% endif %}.{% endif %}
  </p>
  <div class="tiles">
    <div class="tile"><div class="label">Posture score</div><div class="value">{{ summary.score }}<small>/100</small></div></div>
    <div class="tile"><div class="label">Failed checks</div><div class="value">{{ summary.failed }}</div></div>
    <div class="tile"><div class="label">Coverage</div><div class="value">{{ summary.coverage_pct }}<small>%</small></div></div>
    <div class="tile"><div class="label">Alerts</div><div class="value">{{ alert_count }}</div></div>
  </div>

  <h2>Failed findings by severity</h2>
  <div class="bars">
    {% set maxf = [summary.failed_by_severity.values()|max, 1]|max %}
    {% for sev, n in summary.failed_by_severity.items() %}
    <div class="bar-row"><span class="sev {{ sev }}">{{ sev|capitalize }} (weight {{ weights[sev] }})</span>
      <div class="bar-track"><div class="bar" style="width: {{ (100 * n / maxf)|round(1) }}%; background: var(--{{ {'critical':'critical','high':'serious','medium':'warning','low':'low'}[sev] }})"></div></div>
      <span class="num">{{ n }}</span></div>
    {% endfor %}
  </div>
  <p class="muted">Score = 100 &times; (1 &minus; failed weight / evaluated weight). Errors are excluded and lower coverage.</p>

  {% if trend|length > 1 %}
  <h2>Score trend (last {{ trend|length }} scans)</h2>
  <div class="bars">
    {% for t in trend %}
    <div class="bar-row"><code>{{ t.scan_id }}</code>
      <div class="bar-track"><div class="bar" style="width: {{ t.score }}%"></div></div>
      <span class="num">{{ t.score }}</span></div>
    {% endfor %}
  </div>
  {% endif %}

  {% if drift %}
  <h2>Drift since the previous scan</h2>
  <div class="table-wrap"><table>
    <tr><th>Change</th><th>Severity</th><th>Check</th><th>Resource</th><th>Detail</th></tr>
    {% for f in drift.new %}<tr><td class="new">New</td><td><span class="sev {{ f.severity }}">{{ f.severity }}</span></td>
      <td><code>{{ f.check_id }}</code> {{ f.title }}</td><td><code>{{ f.resource_id }}</code></td><td>{{ f.evidence }}</td></tr>{% endfor %}
    {% for f in drift.resolved %}<tr><td class="resolved">Resolved</td><td><span class="sev {{ f.severity }}">{{ f.severity }}</span></td>
      <td><code>{{ f.check_id }}</code> {{ f.title }}</td><td><code>{{ f.resource_id }}</code></td><td></td></tr>{% endfor %}
    {% if not drift.new and not drift.resolved %}<tr><td colspan="5" class="muted">No changes.</td></tr>{% endif %}
  </table></div>
  {% endif %}

  <h2>Findings ({{ fails|length }})</h2>
  <div class="table-wrap"><table>
    <tr><th>Severity</th><th>Check</th><th>Resource</th><th>CIS</th><th>Evidence</th></tr>
    {% for f in fails %}<tr><td><span class="sev {{ f.severity }}">{{ f.severity }}</span></td>
      <td><code>{{ f.check_id }}</code> {{ f.title }}</td><td><code>{{ f.resource_id }}</code></td>
      <td>{{ f.cis_ref }}</td><td>{{ f.evidence }}</td></tr>{% endfor %}
    {% if not fails %}<tr><td colspan="5" class="muted">No failed checks.</td></tr>{% endif %}
  </table></div>
  {% if errors %}<p class="muted">{{ errors|length }} check(s) could not be evaluated:
    {% for f in errors %}<code>{{ f.check_id }}</code> ({{ f.evidence }}){% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}

  <h2>Recommendations</h2>
  <p class="muted">Text only: this system never changes resources itself.</p>
  {% for r in recommendations %}
  <div class="rec"><h3><span class="sev {{ r.finding.severity }}">{{ r.finding.severity }}</span>
      &nbsp;<code>{{ r.finding.check_id }}</code> {{ r.finding.title }}</h3>
    <div>{{ r.finding.recommendation }}</div>
    <div class="muted">Why: {{ r.finding.description }}</div>
    <div class="muted">Affected: {% for res in r.resources %}<code>{{ res }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</div></div>
  {% endfor %}

  {% if alert_count %}
  <h2>Threat detection</h2>
  <div class="table-wrap"><table>
    <tr><th>Rule</th><th class="num">Alerts</th></tr>
    {% for rule, n in alerts_by_rule %}<tr><td>{{ rule }}</td><td class="num">{{ n }}</td></tr>{% endfor %}
  </table></div>
  {% if mttd %}
  <h3>Mean time to detect (simulated attacks)</h3>
  <div class="table-wrap"><table>
    <tr><th>Scenario</th><th>Rule</th><th>Started (UTC)</th><th>Detected (UTC)</th><th class="num">MTTD</th></tr>
    {% for r in mttd %}<tr><td>{{ r.scenario }}</td><td><code>{{ r.rule_id }}</code></td><td>{{ r.started_at }}</td>
      <td>{{ r.detected_at or "missed" }}</td><td class="num">{{ r.mttd_seconds ~ " s" if r.mttd_seconds is not none else "-" }}</td></tr>{% endfor %}
  </table></div>
  {% endif %}
  {% endif %}

  <h2>Method</h2>
  <p class="muted">Custom read-only boto3 checks (CIS AWS Foundations references){% if scan.prowler and 'results' in scan.prowler %} plus Prowler ({{ scan.prowler }}){% endif %};
    findings keyed by check + resource for drift. Detection rules are mapped to MITRE ATT&amp;CK (docs/mitre-mapping.md).
    Generated by <code>python -m scanner report</code>.</p>
</main>
</body>
</html>
