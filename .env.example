# Copy to .env and edit. .env is gitignored.
#
# demo = local AWS emulator (moto), no AWS account needed. Start it with: python -m lab up
# live = real AWS, using the named CLI profile below
CSPM_MODE=demo

AWS_PROFILE=cspm-lab
AWS_REGION=us-east-1
EMULATOR_ENDPOINT=http://127.0.0.1:5001

# Scanner policy thresholds
ADMIN_THRESHOLD=2
ACCESS_KEY_MAX_AGE_DAYS=90
